# Copy to backend/.env for local development.
# On Render, set these in Dashboard -> Environment instead.

FLASK_ENV=development

SECRET_KEY=change-this-to-a-long-random-string
JWT_SECRET_KEY=change-this-to-a-different-long-random-string

# Local MySQL
DATABASE_URL=mysql+pymysql://root:root@localhost/careerbridge_africa

# Hosted Postgres (Render) looks like this instead:
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Password used by "flask --app run.py seed-data"
SEED_PASSWORD=Career2026

# Extra allowed browser origins, comma separated (optional)
# FRONTEND_ORIGINS=https://my-other-frontend.example.com
